{
  "manifest_version": 3,
  "name": "FlowWatch 流量监控",
  "version": "2.0.0",
  "description": "按域名统计浏览/下载流量，支持按日/月/年查看趋势与域名排行。所有数据仅存本地，绝不上传。",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowWatch 流量监控",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}


